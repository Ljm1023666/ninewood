generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum CertLevel {
  NONE
  BASIC
  INTERMEDIATE
  ADVANCED
  MASTER
}

enum ServiceType {
  ONLINE
  OFFLINE
}

enum DemandStatus {
  PENDING
  ACTIVE
  FROZEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  WITHDRAWN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ── AI 2.5+ 新增枚举 ──

enum TagStatus {
  IDLE
  BUSY
  HIDDEN
}

enum ApplicantStatusV2 {
  PENDING
  COMMUNICATING
  ACCEPTED
  REJECTED
  TIMED_OUT
  WITHDRAWN
}

enum LifecycleStage {
  ACTIVE
  NO_COVER
  NO_DETAIL
  ARCHIVED
  DELETED
}

enum CircleLevel {
  COUNTY
  CITY
  PROVINCE
  NATIONAL
}

enum PushFrequency {
  HIGH
  NORMAL
  LOW
  OFF
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_REVIEW
  PARTIAL_PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PartialProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum CircleType {
  PRIVATE
  PUBLIC
}

enum CircleStatus {
  ACTIVE
  WARNING
  DEFUNCT
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum DepositStatus {
  PENDING
  REFUNDED
  FORFEITED
}

enum ComplaintStatus {
  PENDING
  UPHELD
  DISMISSED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  SYSTEM
}

enum DemandStage {
  active
  compressed
  completed
}

enum WalletLedgerType {
  HOLD
  RELEASE
  CREDIT
  DEBIT
}

enum WalletHoldStatus {
  HELD
  RELEASED
  CONSUMED
}

// Wave A / Task 8 circle hub enums
enum CircleResourceCategory {
  DOC
  DESIGN
  CODE
  VIDEO
  OTHER
}

enum CircleActivityType {
  DISCUSSION
  DEMAND
  MEMBER_JOIN
  RESOURCE
  ANNOUNCEMENT
}

enum CircleInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TagCategory {
  service
  demand
  both
}

model User {
  id                      String    @id @default(uuid())
  accountNo               Int?      @unique // 易记账号 ID：0=管理员，1、2…递增
  phone                   String    @unique
  email                   String?   @unique
  nickname                String
  avatarUrl               String?
  coverUrl                String?
  demandCardCoverUrl      String?
  cityCode                String?
  ipRegion                String? // IP属地缓存，如"北京"
  certificationLevel      CertLevel @default(NONE)
  snatchCredits           Int       @default(3)
  creditScore             Int       @default(60)
  completedOrders         Int       @default(0)
  // S1.2 修复:开发期模拟货币(1 点 = 1 元;见 DEVELOPMENT-GUIDE 决策 D5)
  points                  Int       @default(1000000)
  role                    String    @default("USER")
  passwordHash            String?
  bio                     String?
  // 合规：注册时强制采集，< 14 岁直接拒绝（生成式 AI 办法 §10 / 未保法 §74-75）
  // 公测前需补：14-18 岁监护人同意流程
  birthday                DateTime?
  pushBlocklist           Json      @default("{\"tags\":[],\"keywords\":[],\"ageRanges\":[]}")
  hasVisitedCompletedList Boolean   @default(false)
  serviceTags             String[]  @default([])
  isBusy                  Boolean   @default(false)
  allowSpecialSearch      Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  demands             Demand[]
  applications        DemandApplication[]
  providerOrders      Order[]                   @relation("Provider")
  requesterOrders     Order[]                   @relation("Requester")
  ownedCircles        Circle[]                  @relation("CircleOwner")
  memberships         CircleMember[]
  circleAnnouncements CircleAnnouncement[]
  circleActivities    CircleActivity[]
  circleResources     CircleResource[]
  circleInvitesSent   CircleInvite[]            @relation("CircleInvitesSent")
  deposits            Deposit[]
  sentComplaints      Complaint[]               @relation("Complainant")
  receivedComplaints  Complaint[]               @relation("Respondent")
  blocksInitiated     UserBlock[]               @relation("UserBlocks")
  blocksReceived      UserBlock[]               @relation("BlockedByUsers")
  reportsFiled        ContentReport[]           @relation("ReportsFiled")
  reportsReceived     ContentReport[]           @relation("ReportsReceived")
  sentMessages        Message[]                 @relation("Sender")
  receivedMessages    Message[]                 @relation("Receiver")
  serviceCards        ServiceCard[]
  shorts              Short[]
  following           Follow[]                  @relation("Following")
  followers           Follow[]                  @relation("Followers")
  favorites           DemandFavorite[]
  certifiedProvider   CertifiedProvider?
  mergeMemberships    ConversationMergeMember[]
  reviewsGiven        Review[]                  @relation("Reviewer")
  reviewsReceived     Review[]                  @relation("Reviewee")
  agentTasks          AgentTask[]

  // ── AI 2.5 ──
  userTags       UserTag[]
  applicantsV2   DemandApplicantV2[]
  pushPreference PushPreference?

  // ── 产品时间主权 Phase 1A ──
  notificationPolicy        NotificationPolicy?
  notificationSubscriptions NotificationSubscription[]
  notificationDeliveries    NotificationDelivery[]
  // ── 产品时间主权 Phase 2 ──
  taskQuietRecords          TaskQuietRecord[]

  @@index([cityCode])
  @@index([certificationLevel])
}

model Demand {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String
  minPrice            Decimal      @db.Decimal(10, 2)
  category            String
  taxonomyLeafId      String?
  serviceType         ServiceType
  cityCode            String?
  regionId            Int?
  region              Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  tagName             String? // 关联的标签卡包（null=未分类?卡包）
  isCertifiedOnly     Boolean      @default(false)
  completedCoverImage String? // 死池永久封面（完成时锁定，不可更改）
  colorBar            String? // 死池色条
  pushConfig          Json?
  stage               DemandStage  @default(active)
  coverImage          String?
  amountEstimate      Decimal?     @db.Decimal(10, 2)
  expireAt            DateTime
  status              DemandStatus @default(PENDING)
  circleId            String?
  circle              Circle?      @relation(fields: [circleId], references: [id], onDelete: SetNull)
  mediaUrls           Json         @default("[]")
  applicantCount      Int          @default(0)
  isExample           Boolean      @default(false)
  isPublic            Boolean      @default(true)
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())

  // ── AI 2.5: 紧急窗口 ──
  visibilityWindow   Int            @default(15)
  visibleUntil       DateTime?
  frozenAt           DateTime?
  // ── AI 2.5: 效果导向 ──
  expectedOutcome    String?
  timeLimit          DateTime?
  // ── AI 2.5: 押金 + 接单控制 ──
  deposit            Float          @default(0)
  maxApplicants      Int            @default(10)
  // ── AI 2.5: 标签确认 ──
  tags               String[]       @default([])
  aiTags             String[]       @default([])
  tagsConfirmed      Boolean        @default(false)
  // ── AI 2.5: 位置模糊 ──
  fuzzyLat           Float?
  fuzzyLng           Float?
  // ── AI 2.5: 正式接单 ──
  acceptedProviderId String?
  // ── AI 2.5: 生命周期 ──
  lifecycleStage     LifecycleStage @default(ACTIVE)
  coverDeletedAt     DateTime?
  detailDeletedAt    DateTime?
  fullDeletedAt      DateTime?
  // ── AI 2.5: 公益 ──
  isPublicWelfare    Boolean        @default(false)

  // ── TASK-11: 路径检索 ──
  paths         String[]  @default([])
  pathsEditedAt DateTime?

  applications     DemandApplication[]
  applicantsV2     DemandApplicantV2[]
  circleDemands    CircleDemand[]
  orders           Order[]
  favoritedBy      DemandFavorite[]
  depositRelations DepositDemand[]
  activeDemand     ActiveDemand?
  cardAttachments  CardAttachment[]

  @@index([userId])
  @@index([cityCode])
  @@index([status])
  @@index([expireAt])
  @@index([circleId])
  @@index([category])
  @@index([taxonomyLeafId])
  @@index([isExample])
  @@index([regionId, stage])
  @@index([stage, createdAt])
  @@index([status, visibleUntil])
  @@index([frozenAt])
  @@index([paths], type: Gin)
}

model DemandApplication {
  id         String            @id @default(uuid())
  demandId   String
  demand     Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerPrice Decimal?          @db.Decimal(10, 2)
  message    String?
  isSnatched Boolean           @default(false)
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())

  @@unique([demandId, userId])
  @@index([userId])
  @@index([demandId])
  @@index([status])
}

// 面向检索与咨询的服务声明卡，任何用户均可发布。
model ServiceCard {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  summary      String?
  description  String
  coverImage   String?
  category     String
  serviceType  ServiceType @default(ONLINE)
  cityCode     String?
  regionId     Int?
  region       Region?     @relation(fields: [regionId], references: [id], onDelete: SetNull)
  paths        String[]    @default([])
  tags         String[]    @default([])
  priceMin     Decimal?    @db.Decimal(10, 2)
  priceMax     Decimal?    @db.Decimal(10, 2)
  priceUnit    String?
  deliveryMode String      @default("ONLINE")
  availability String      @default("AVAILABLE")
  status       String      @default("DRAFT") // DRAFT | PUBLISHED | PAUSED | ARCHIVED
  isPublic     Boolean     @default(true)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  claims          ServiceCardClaim[]
  evidence        ServiceCardEvidence[]
  cardAttachments CardAttachment[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([category])
  @@index([regionId])
  @@index([paths], type: Gin)
  @@index([tags], type: Gin)
}

// 服务者的主观能力声明，isHighlighted 只由系统经验聚合写入。
model ServiceCardClaim {
  id            String      @id @default(uuid())
  serviceCardId String
  serviceCard   ServiceCard @relation(fields: [serviceCardId], references: [id], onDelete: Cascade)
  label         String
  description   String?
  sortOrder     Int         @default(0)
  isHighlighted Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([serviceCardId, label])
  @@index([label])
}

// 公开聚合事实，不保存客户身份、需求正文或订单号。
model ServiceCardEvidence {
  id              String      @id @default(uuid())
  serviceCardId   String
  serviceCard     ServiceCard @relation(fields: [serviceCardId], references: [id], onDelete: Cascade)
  label           String
  completedCount  Int         @default(0)
  successfulCount Int         @default(0)
  successRate     Float?
  lastCompletedAt DateTime?
  sourceType      String      @default("COMPLETED_ORDER")
  sourceVersion   Int         @default(1)
  calculatedAt    DateTime    @default(now())

  @@unique([serviceCardId, label])
  @@index([label, completedCount])
}

// 卡片作为消息附件发送时的不可变展示快照。
model CardAttachment {
  id            String       @id @default(uuid())
  messageId     String       @unique
  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  cardType      String // DEMAND | SERVICE_CARD
  demandId      String?
  demand        Demand?      @relation(fields: [demandId], references: [id], onDelete: SetNull)
  serviceCardId String?
  serviceCard   ServiceCard? @relation(fields: [serviceCardId], references: [id], onDelete: SetNull)
  snapshot      Json
  createdAt     DateTime     @default(now())

  @@index([cardType])
  @@index([demandId])
  @@index([serviceCardId])
}

model Order {
  id          String      @id @default(uuid())
  demandId    String      @unique
  demand      Demand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  providerId  String
  provider    User        @relation("Provider", fields: [providerId], references: [id])
  requesterId String
  requester   User        @relation("Requester", fields: [requesterId], references: [id])
  agreedPrice Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  paidAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  messages         Message[]
  reviews          Review[]
  partialProposals OrderPartialProposal[]

  @@index([demandId])
  @@index([providerId])
  @@index([requesterId])
  @@index([status])
}

model OrderPartialProposal {
  id                String                @id @default(uuid())
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proposedPrice     Decimal               @db.Decimal(10, 2)
  description       String
  status            PartialProposalStatus @default(PENDING)
  proposedBy        String
  decidedBy         String?
  decidedAt         DateTime?
  remainingDemandId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([orderId, status])
}

model IdempotencyRecord {
  id           String            @id @default(uuid())
  userId       String
  scope        String
  key          String
  resourceId   String
  requestHash  String?
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?
  responseBody Json?
  leaseUntil   DateTime
  leaseOwner   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, scope, key])
  @@index([resourceId, scope])
  @@index([status, leaseUntil])
}

model Circle {
  id          String       @id @default(uuid())
  name        String
  description String?
  type        CircleType
  ownerId     String
  owner       User         @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  cityCode    String?
  inviteCode  String?      @unique
  coverUrl    String?
  memberCount Int          @default(1)
  activeScore Float        @default(0)
  status      CircleStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  members       CircleMember[]
  demands       Demand[]
  circleDemands CircleDemand[]
  announcements CircleAnnouncement[]
  activities    CircleActivity[]
  resources     CircleResource[]
  invites       CircleInvite[]

  @@index([ownerId])
  @@index([cityCode])
  @@index([status])
}

model CircleMember {
  circleId   String
  circle     Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole @default(MEMBER)
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime?

  @@id([circleId, userId])
  @@index([circleId])
  @@index([userId])
  @@index([circleId, lastSeenAt])
}

model Deposit {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  status    DepositStatus @default(PENDING)
  createdAt DateTime      @default(now())

  demandRelations DepositDemand[]

  @@index([userId])
  @@index([status])
}

model DepositDemand {
  depositId String
  deposit   Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  demandId  String
  demand    Demand  @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@id([depositId, demandId])
}

model Complaint {
  id           String          @id @default(uuid())
  fromUserId   String
  fromUser     User            @relation("Complainant", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User            @relation("Respondent", fields: [toUserId], references: [id], onDelete: Cascade)
  demandId     String
  reason       String
  evidenceUrls String[]        @default([])
  status       ComplaintStatus @default(PENDING)
  result       String?
  createdAt    DateTime        @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([demandId])
}

model UserBlock {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
  @@index([userId])
  @@index([blockedId])
}

model ContentReport {
  id           String          @id @default(uuid())
  reporterId   String
  reporter     User            @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User            @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  messageId    String?
  message      Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  demandId     String?
  category     String          @default("other")
  reason       String
  status       ComplaintStatus @default(PENDING)
  createdAt    DateTime        @default(now())

  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  content    String?
  createdAt  DateTime @default(now())

  @@index([reviewerId])
  @@index([revieweeId])
  @@unique([orderId, reviewerId])
}

model EmailVerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model SchedulerLease {
  name       String   @id
  owner      String
  leaseUntil DateTime
  updatedAt  DateTime @updatedAt

  @@index([leaseUntil])
}

model OutcomeEvent {
  id            String   @id @default(uuid())
  userId        String?
  correlationId String
  resourceType  String
  resourceId    String
  eventType     String
  occurredAt    DateTime @default(now())
  activeMs      Int?
  metadata      Json     @default("{}")

  @@index([correlationId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([eventType, occurredAt])
}

model OutcomeDailyAggregate {
  day          DateTime
  resourceType String
  eventType    String
  eventCount   Int
  activeMsSum  BigInt    @default(0)
  sampleCount  Int       @default(0)
  updatedAt    DateTime  @updatedAt

  @@id([day, resourceType, eventType])
  @@index([day])
}

model Message {
  id             String          @id @default(uuid())
  fromUserId     String
  fromUser       User            @relation("Sender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         User            @relation("Receiver", fields: [toUserId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  content        String
  type           MessageType     @default(TEXT)
  duration       Int?
  mergeId        String?
  isRead         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  reports        ContentReport[]
  cardAttachment CardAttachment?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([orderId])
  @@index([mergeId])
  @@index([createdAt])
}

model Short {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl    String
  coverUrl    String?
  description String?
  tags        Json     @default("[]")
  likeCount   Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ConversationMerge {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())

  members ConversationMergeMember[]
}

model ConversationMergeMember {
  mergeId String
  merge   ConversationMerge @relation(fields: [mergeId], references: [id], onDelete: Cascade)
  userId  String
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([mergeId, userId])
  @@index([userId])
}

model DemandFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, demandId])
  @@index([userId])
  @@index([demandId])
}

// ── Agent 对话系统 ──

model AgentConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("新对话")
  model     String?
  provider  String? // minimax | deepseek
  thinkMode Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system | tool
  content        String
  thinking       String? // 思考过程（DeepSeek V4 thinking/reasoning）
  toolCalls      Json? // 工具调用记录 [{ name, arguments, result }]
  tokenCount     Int?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ── 行政区划表 ──

model Region {
  id       Int    @id
  name     String @db.VarChar(100)
  level    Int // 1=国家 2=省 3=市 4=区县
  parentId Int    @default(0)
  lat      Float?
  lng      Float?

  demands            Demand[]
  serviceCards       ServiceCard[]
  certifiedProviders CertifiedProvider[]

  @@index([parentId])
}

// ── 标签表 ──

model Tag {
  name                 String      @id @db.VarChar(50)
  category             TagCategory @default(both)
  totalCompleted       Int         @default(0)
  totalEstimatedAmount Decimal     @default(0) @db.Decimal(12, 2)
  colorHistogram       Json        @default("[]")
}

// ── 认证服务者表 ──

model CertifiedProvider {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedAt     DateTime @default(now())
  tags           String[] @default([])
  regionId       Int?
