generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum CertLevel {
  NONE
  BASIC
  INTERMEDIATE
  ADVANCED
  MASTER
}

enum ServiceType {
  ONLINE
  OFFLINE
}

enum DemandStatus {
  PENDING
  ACTIVE
  FROZEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  WITHDRAWN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ── AI 2.5+ 新增枚举 ──

enum TagStatus {
  IDLE
  BUSY
  HIDDEN
}

enum ApplicantStatusV2 {
  PENDING
  COMMUNICATING
  ACCEPTED
  REJECTED
  TIMED_OUT
  WITHDRAWN
}

enum LifecycleStage {
  ACTIVE
  NO_COVER
  NO_DETAIL
  ARCHIVED
  DELETED
}

enum CircleLevel {
  COUNTY
  CITY
  PROVINCE
  NATIONAL
}

enum PushFrequency {
  HIGH
  NORMAL
  LOW
  OFF
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_REVIEW
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum CircleType {
  PRIVATE
  PUBLIC
}

enum CircleStatus {
  ACTIVE
  WARNING
  DEFUNCT
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum DepositStatus {
  PENDING
  REFUNDED
  FORFEITED
}

enum ComplaintStatus {
  PENDING
  UPHELD
  DISMISSED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  SYSTEM
}

enum DemandStage {
  active
  compressed
  completed
}


enum WalletLedgerType {
  HOLD
  RELEASE
  CREDIT
  DEBIT
}

enum WalletHoldStatus {
  HELD
  RELEASED
  CONSUMED
}

// Wave A / Task 8 circle hub enums
enum CircleResourceCategory {
  DOC
  DESIGN
  CODE
  VIDEO
  OTHER
}

enum CircleActivityType {
  DISCUSSION
  DEMAND
  MEMBER_JOIN
  RESOURCE
  ANNOUNCEMENT
}

enum CircleInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TagCategory {
  service
  demand
  both
}

model User {
  id                 String    @id @default(uuid())
  accountNo          Int?      @unique // 易记账号 ID：0=管理员，1、2…递增
  phone              String    @unique
  email              String?   @unique
  nickname           String
  avatarUrl          String?
  coverUrl           String?
  demandCardCoverUrl String?
  cityCode           String?
  ipRegion           String?   // IP属地缓存，如"北京"
  certificationLevel CertLevel @default(NONE)
  snatchCredits      Int       @default(3)
  creditScore        Int       @default(60)
  completedOrders    Int       @default(0)
  // S1.2 修复:开发期模拟货币(1 点 = 1 元;见 DEVELOPMENT-GUIDE 决策 D5)
  points             Int       @default(1000000)
  role               String    @default("USER")
  passwordHash       String?
  bio                String?
  // 合规：注册时强制采集，< 14 岁直接拒绝（生成式 AI 办法 §10 / 未保法 §74-75）
  // 公测前需补：14-18 岁监护人同意流程
  birthday           DateTime?
  pushBlocklist      Json      @default("{\"tags\":[],\"keywords\":[],\"ageRanges\":[]}")
  hasVisitedCompletedList Boolean   @default(false)
  serviceTags            String[]  @default([])
  isBusy                 Boolean   @default(false)
  allowSpecialSearch     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  demands             Demand[]
  applications        DemandApplication[]
  providerOrders      Order[]     @relation("Provider")
  requesterOrders     Order[]     @relation("Requester")
  ownedCircles        Circle[]    @relation("CircleOwner")
  memberships         CircleMember[]
  circleAnnouncements CircleAnnouncement[]
  circleActivities    CircleActivity[]
  circleResources     CircleResource[]
  circleInvitesSent   CircleInvite[]   @relation("CircleInvitesSent")
  deposits            Deposit[]
  sentComplaints      Complaint[] @relation("Complainant")
  receivedComplaints  Complaint[] @relation("Respondent")
  sentMessages        Message[]   @relation("Sender")
  receivedMessages    Message[]   @relation("Receiver")
  shorts              Short[]
  following           Follow[]    @relation("Following")
  followers           Follow[]    @relation("Followers")
  favorites           DemandFavorite[]
  certifiedProvider   CertifiedProvider?
  mergeMemberships    ConversationMergeMember[]
  reviewsGiven        Review[]         @relation("Reviewer")
  reviewsReceived     Review[]         @relation("Reviewee")
  agentTasks          AgentTask[]

  // ── AI 2.5 ──
  userTags           UserTag[]
  applicantsV2       DemandApplicantV2[]
  pushPreference     PushPreference?

  @@index([cityCode])
  @@index([certificationLevel])
}

model Demand {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String
  minPrice         Decimal      @db.Decimal(10, 2)
  category         String
  taxonomyLeafId   String?
  serviceType      ServiceType
  cityCode         String?
  regionId         Int?
  region           Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  tagName          String?      // 关联的标签卡包（null=未分类?卡包）
  isCertifiedOnly  Boolean      @default(false)
  completedCoverImage String?   // 死池永久封面（完成时锁定，不可更改）
  colorBar         String?      // 死池色条
  pushConfig       Json?
  stage            DemandStage  @default(active)
  coverImage       String?
  amountEstimate   Decimal?     @db.Decimal(10, 2)
  expireAt         DateTime
  status           DemandStatus @default(PENDING)
  circleId         String?
  circle           Circle?      @relation(fields: [circleId], references: [id], onDelete: SetNull)
  mediaUrls        Json         @default("[]")
  applicantCount   Int          @default(0)
  isExample        Boolean      @default(false)
  isPublic         Boolean      @default(true)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())

  // ── AI 2.5: 紧急窗口 ──
  visibilityWindow Int          @default(15)
  visibleUntil     DateTime?
  frozenAt         DateTime?
  // ── AI 2.5: 效果导向 ──
  expectedOutcome  String?
  timeLimit        DateTime?
  // ── AI 2.5: 押金 + 接单控制 ──
  deposit          Float        @default(0)
  maxApplicants    Int          @default(10)
  // ── AI 2.5: 标签确认 ──
  tags             String[]     @default([])
  aiTags           String[]     @default([])
  tagsConfirmed    Boolean      @default(false)
  // ── AI 2.5: 位置模糊 ──
  fuzzyLat         Float?
  fuzzyLng         Float?
  // ── AI 2.5: 正式接单 ──
  acceptedProviderId String?
  // ── AI 2.5: 生命周期 ──
  lifecycleStage   LifecycleStage @default(ACTIVE)
  coverDeletedAt   DateTime?
  detailDeletedAt  DateTime?
  fullDeletedAt    DateTime?
  // ── AI 2.5: 公益 ──
  isPublicWelfare  Boolean      @default(false)

  // ── TASK-11: 路径检索 ──
  paths          String[]  @default([])
  pathsEditedAt  DateTime?

  applications     DemandApplication[]
  applicantsV2     DemandApplicantV2[]
  circleDemands    CircleDemand[]
  orders           Order[]
  favoritedBy      DemandFavorite[]
  depositRelations DepositDemand[]
  activeDemand     ActiveDemand?

  @@index([userId])
  @@index([cityCode])
  @@index([status])
  @@index([expireAt])
  @@index([circleId])
  @@index([category])
  @@index([taxonomyLeafId])
  @@index([isExample])
  @@index([regionId, stage])
  @@index([stage, createdAt])
  @@index([status, visibleUntil])
  @@index([frozenAt])
  @@index([paths], type: Gin)
}

model DemandApplication {
  id         String            @id @default(uuid())
  demandId   String
  demand     Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerPrice Decimal?          @db.Decimal(10, 2)
  message    String?
  isSnatched Boolean           @default(false)
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())

  @@unique([demandId, userId])
  @@index([userId])
  @@index([demandId])
  @@index([status])
}

model Order {
  id          String      @id @default(uuid())
  demandId    String
  demand      Demand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  providerId  String
  provider    User        @relation("Provider", fields: [providerId], references: [id])
  requesterId String
  requester   User        @relation("Requester", fields: [requesterId], references: [id])
  agreedPrice Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  paidAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  messages Message[]
  reviews  Review[]

  @@index([demandId])
  @@index([providerId])
  @@index([requesterId])
  @@index([status])
}

model Circle {
  id          String       @id @default(uuid())
  name        String
  description String?
  type        CircleType
  ownerId     String
  owner       User         @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  cityCode    String?
  inviteCode  String?      @unique
  coverUrl    String?
  memberCount Int          @default(1)
  activeScore Float        @default(0)
  status      CircleStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  members        CircleMember[]
  demands        Demand[]
  circleDemands  CircleDemand[]
  announcements  CircleAnnouncement[]
  activities     CircleActivity[]
  resources      CircleResource[]
  invites        CircleInvite[]

  @@index([ownerId])
  @@index([cityCode])
  @@index([status])
}

model CircleMember {
  circleId   String
  circle     Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole @default(MEMBER)
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime?

  @@id([circleId, userId])
  @@index([circleId])
  @@index([userId])
  @@index([circleId, lastSeenAt])
}

model Deposit {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal         @db.Decimal(10, 2)
  status          DepositStatus   @default(PENDING)
  createdAt       DateTime        @default(now())

  demandRelations DepositDemand[]

  @@index([userId])
  @@index([status])
}

model DepositDemand {
  depositId String
  deposit   Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  demandId  String
  demand    Demand  @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@id([depositId, demandId])
}

model Complaint {
  id         String          @id @default(uuid())
  fromUserId String
  fromUser   User            @relation("Complainant", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User            @relation("Respondent", fields: [toUserId], references: [id], onDelete: Cascade)
  demandId   String
  reason       String
  evidenceUrls String[]     @default([])
  status       ComplaintStatus @default(PENDING)
  result     String?
  createdAt  DateTime        @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([demandId])
}

model Review {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5
  content     String?
  createdAt   DateTime @default(now())

  @@index([reviewerId])
  @@index([revieweeId])
}

model Message {
  id         String      @id @default(uuid())
  fromUserId String
  fromUser   User        @relation("Sender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User        @relation("Receiver", fields: [toUserId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  content    String
  type       MessageType @default(TEXT)
  duration   Int?
  mergeId    String?
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([orderId])
  @@index([mergeId])
  @@index([createdAt])
}

model Short {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl    String
  coverUrl    String?
  description String?
  tags        Json     @default("[]")
  likeCount   Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ConversationMerge {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())

  members ConversationMergeMember[]
}

model ConversationMergeMember {
  mergeId String
  merge   ConversationMerge @relation(fields: [mergeId], references: [id], onDelete: Cascade)
  userId  String
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([mergeId, userId])
  @@index([userId])
}

model DemandFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, demandId])
  @@index([userId])
  @@index([demandId])
}

// ── Agent 对话系统 ──

model AgentConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("新对话")
  model     String?
  provider  String?  // minimax | deepseek
  thinkMode Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model AgentMessage {
  id             String   @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String   // user | assistant | system | tool
  content        String
  thinking       String?  // 思考过程（DeepSeek V4 thinking/reasoning）
  toolCalls      Json?    // 工具调用记录 [{ name, arguments, result }]
  tokenCount     Int?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ── 行政区划表 ──

model Region {
  id       Int      @id
  name     String   @db.VarChar(100)
  level    Int      // 1=国家 2=省 3=市 4=区县
  parentId Int      @default(0)
  lat      Float?
  lng      Float?

  demands          Demand[]
  certifiedProviders CertifiedProvider[]

  @@index([parentId])
}

// ── 标签表 ──

model Tag {
  name                String     @id @db.VarChar(50)
  category            TagCategory @default(both)
  totalCompleted      Int        @default(0)
  totalEstimatedAmount Decimal   @default(0) @db.Decimal(12, 2)
  colorHistogram      Json       @default("[]")
}

// ── 认证服务者表 ──

model CertifiedProvider {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedAt     DateTime @default(now())
  tags           String[] @default([])
  regionId       Int?
  region         Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  avgRating      Float    @default(0)
  totalCompleted Int      @default(0)

  @@index([regionId])
}

// ── 活池需求扩展表（时间杠杆） ──

model ActiveDemand {
  demandId           String    @id
  demand             Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  totalExtendedMonths Int      @default(0)
  nextCompressionDate DateTime?
}

// ─── AI 2.5+ 新增模型 ───

// 服务者标签状态
model UserTag {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagName     String    @db.VarChar(50)
  status      TagStatus @default(IDLE)
  regionId    Int?
  certified   Boolean   @default(false)
  autoReceive Boolean   @default(false)
  rating      Float     @default(0)
  orderCount  Int       @default(0)
  metadata    Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, tagName])
  @@index([status, tagName])
  @@index([tagName, certified])
  @@index([status, regionId])
}

// 需求申请记录（两段式接单 + 沟通窗口）
model DemandApplicantV2 {
  id              String           @id @default(uuid())
  demandId        String
  demand          Demand           @relation(fields: [demandId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  message         String           // 申请理由

  status          ApplicantStatusV2 @default(PENDING)

  // 沟通窗口
  commStartAt     DateTime?
  commDeadline    DateTime?
  extensionMinutes Int             @default(0)

  createdAt       DateTime         @default(now())

  @@unique([demandId, userId])
  @@index([demandId, status])
  @@index([userId])
}

// 公益资金池
model WelfareFundPool {
  id           String   @id @default(uuid())
  regionId     Int      @unique
  balance      Float    @default(0)
  totalInflow  Float    @default(0)
  totalOutflow Float    @default(0)
  updatedAt    DateTime @updatedAt
}

// 需求圈-需求关联
model CircleDemand {
  id         String   @id @default(uuid())
  circleId   String
  demandId   String
  demand     Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  isExternal Boolean  @default(false)
  isPublic   Boolean  @default(false)
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([circleId, demandId])
}

// 推送偏好
model PushPreference {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  excludeKeywords String[]      @default([])
  excludeTags     String[]      @default([])
  excludeRegions  Int[]         @default([])
  receivePushes   Boolean       @default(true)
  pushFrequency   PushFrequency @default(NORMAL)
}



// 公益/钱包流水
model WalletHold {
  id          String   @id @default(uuid())
  userId      String
  demandId    String   @unique
  amount      Float
  status      WalletHoldStatus @default(HELD)
  releasedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model WalletLedger {
  id            String   @id @default(uuid())
  userId        String
  type          WalletLedgerType
  amount        Float
  balanceAfter  Float
  referenceType String?
  referenceId   String?
  memo          String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

// 结算记录
model Settlement {
  id               String   @id @default(uuid())
  demandId         String   @unique
  minPrice         Float
  finalPrice       Float
  serviceFee       Float
  demanderPaid     Float
  providerReceived Float
  platformRevenue  Float
  depositReturned  Float
  isWelfare        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}



model WelfareDisbursement {
  id           String   @id @default(uuid())
  regionId     Int
  amount       Float
  recipientOrg String   @db.VarChar(200)
  memo         String?  @db.VarChar(500)
  operatorId   String
  createdAt    DateTime @default(now())

  @@index([regionId])
  @@index([createdAt])
}

// 公益随机奖励
model WelfareReward {
  id           String   @id @default(uuid())
  demandId     String
  providerId   String
  amount       Float    @default(0)
  isSpiritual  Boolean  @default(false)
  rewardType   String   @default("random") // random | spiritual | choice
  choiceLabel  String?  @db.VarChar(100)
  badge        String?
  fundPoolId   String?
  createdAt    DateTime @default(now())

  @@index([providerId])
  @@index([demandId])
}

// 标签统计
model TagStats {
  id               String   @id @default(uuid())
  tagName          String   @db.VarChar(50)
  regionId         Int
  totalCards       Int      @default(0)
  totalAmount      Float    @default(0)
  avgAmount        Float    @default(0)
  activeProviders  Int      @default(0)
  activeDemands    Int      @default(0)
  periodStart      DateTime
  periodEnd        DateTime
  updatedAt        DateTime @updatedAt

  @@unique([tagName, regionId, periodStart])
  @@index([tagName, regionId])
}


// Wave A / Task 8 circle hub tables

model CircleAnnouncement {
  id        String   @id @default(uuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  pinned    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId, pinned])
  @@index([circleId, createdAt])
}

model CircleActivity {
  id        String             @id @default(uuid())
  circleId  String
  circle    Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      CircleActivityType
  title     String
  summary   String?
  refId     String?
  createdAt DateTime           @default(now())

  @@index([circleId, createdAt])
  @@index([circleId, type])
}

model CircleResource {
  id         String                 @id @default(uuid())
  circleId   String
  circle     Circle                 @relation(fields: [circleId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User                   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  mimeType   String?
  sizeBytes  Int
  category   CircleResourceCategory @default(OTHER)
  createdAt  DateTime               @default(now())

  @@index([circleId, createdAt])
  @@index([circleId, category])
}

model CircleInvite {
  id          String             @id @default(uuid())
  circleId    String
  circle      Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User               @relation("CircleInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status      CircleInviteStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  expiresAt   DateTime?

  @@unique([circleId, email, status])
  @@index([circleId, status])
  @@index([circleId, createdAt])
}

// ── Task 10 · Agent 自动化任务 ──
// 平台宪法：调度器只读 + 只推送；详见 docs/specs/TASK-10-agent-automation.md §0.1

model AgentTask {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             String   // 注册表键；MVP: "DEMAND_DIGEST"
  enabled          Boolean  @default(true)
  frequency        String   // HOURLY | DAILY | WEEKLY
  atHour           Int?     // DAILY/WEEKLY: 0-23
  atMinute         Int      @default(0)
  weekday          Int?     // WEEKLY: 1-7 (周一=1)
  filters          Json     // 类型私有参数（DEMAND_DIGEST: keyword/category/...）
  deliveryChannels Json     // ["MESSAGE","AGENT_INBOX"] — JSON 数组
  lastRunAt        DateTime?
  nextRunAt        DateTime
  lastSummary      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runs AgentTaskRun[]

  @@index([userId])
  @@index([enabled, nextRunAt])
}

model AgentTaskRun {
  id          String    @id @default(uuid())
  taskId      String
  task        AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runAt       DateTime  @default(now())
  status      String    // SUCCESS | EMPTY | ERROR
  resultCount Int       @default(0)
  summary     String    // Markdown 摘要
  payload     Json?     // 结构化结果 [{ id, title, path, price, ... }]
  readAt      DateTime? // AGENT_INBOX 已读时间（null=未读）
  createdAt   DateTime  @default(now())

  @@index([taskId, runAt])
  @@index([taskId, readAt])
}
